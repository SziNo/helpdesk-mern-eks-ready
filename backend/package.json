{
  "name": "helpdesk-backend",
  "version": "2.0.0",
  "description": "Helpdesk / support ticket app - REST API (Express + MongoDB)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "pretest": "node test/check-env.js",
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "lint": "eslint ."
  },
  "author": "Norbert Szikora",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
