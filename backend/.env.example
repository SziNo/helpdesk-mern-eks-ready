# Helpdesk backend - környezeti változók mintája.
# Helyi fejlesztéshez: másold .env néven és töltsd ki (a .env NEM kerül gitbe).
# Kubernetesben ezeket ConfigMap (nem titkos) és Secret (titkos) adja meg.

# KÖTELEZŐ - MongoDB kapcsolati URI (helyi példa; Atlasnál mongodb+srv://...)
MONGO_URI=mongodb://localhost:27017/helpdesk

# KÖTELEZŐ - a JWT tokenek aláírókulcsa. Hosszú, véletlen érték legyen, pl.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcionális - HTTP port (alapértelmezés: 8080)
PORT=8080

# Opcionális - development | production (production módban a hibaválaszban nincs stack trace)
NODE_ENV=development

# Opcionális - mely proxyk X-Forwarded-For fejlécében bízzunk
# (Express "trust proxy" érték; alapértelmezés: loopback, linklocal, uniquelocal)
# TRUST_PROXY=loopback, linklocal, uniquelocal
